---
import Layout from "../layouts/Layout.astro";

const confessionalBoothUrl = "/2026/08/26/confessional-booth.html";
---

<Layout
    title="About — Eric Brookfield"
    description="About Eric Brookfield's writing, AI use, and authorship standards."
>
    <article class="about">
        <div class="container">
            <header class="about-header">
                <a href="/" class="back-link">Back</a>
                <h1>About this site</h1>
            </header>

            <div class="about-content">
                <p><strong>Eric Brookfield</strong> — engineer, builder, writer, father.</p>

                <h2>On AI and writing</h2>

                <p>
                    I use generative AI extensively — for research, for software
                    development, for exploration, analysis, editing, and creative
                    collaboration. It’s a real tool, not a magic wand, and I treat
                    it that way.
                </p>

                <p>
                    Writing published under my name should be writing I
                    meaningfully authored and stand behind. AI involvement doesn’t
                    itself negate authorship; I direct, edit, and sign off on
                    everything here. Where that standard isn’t met — where a piece
                    was substantially generated by AI rather than authored by me —
                    I’ll try to disclose it.
                </p>

                <p>
                    That’s the short version. <a href={confessionalBoothUrl}>Confessional Booth</a> is where
                    I talk through how I got here, what changed, and how I handle
                    posts whose voice isn’t mine.
                </p>

                <hr />

                <p class="about-note">
                    This is a living statement — updated as the practice changes.
                </p>
            </div>

            <footer class="about-footer">
                <a href="/">Home</a>
                <a href="/archive">Archive</a>
            </footer>
        </div>
    </article>
</Layout>

<style>
    .about {
        padding: var(--spacing-xl) 0;
        min-height: 100vh;
    }

    .container {
        max-width: 720px;
    }

    .about-header {
        margin-bottom: var(--spacing-lg);
        padding-bottom: var(--spacing-md);
        border-bottom: 1px solid var(--color-rule);
    }

    .about-header h1 {
        font-size: var(--text-h1);
        line-height: 1.15;
        letter-spacing: -0.03em;
        margin-bottom: 0;
    }

    .back-link {
        display: inline-block;
        margin-bottom: var(--spacing-md);
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        text-decoration: none;
        border-bottom: 1px solid var(--color-rule);
        padding-bottom: 1px;
    }

    .back-link:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
    }

    .about-content {
        font-size: clamp(1rem, 1.15vw, 1.0625rem);
        line-height: 1.75;
        margin-bottom: var(--spacing-xl);
    }

    .about-content p {
        margin: 0 0 1.5rem;
        color: var(--color-text-muted);
    }

    .about-content strong {
        color: var(--color-text);
        font-weight: 600;
    }

    .about-content h2 {
        font-size: clamp(1.375rem, 2.5vw, 1.75rem);
        margin-top: var(--spacing-lg);
        margin-bottom: var(--spacing-sm);
        letter-spacing: -0.02em;
    }

    .about-content h2::after {
        display: none;
    }

    .about-content a {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .about-content a:hover {
        color: var(--color-text);
    }

    .about-content hr {
        border: none;
        height: 1px;
        background: var(--color-rule);
        margin: var(--spacing-lg) 0;
    }

    .about-content .about-note {
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .about-footer {
        display: flex;
        gap: var(--spacing-md);
        padding-top: var(--spacing-md);
        border-top: 1px solid var(--color-rule);
        font-family: var(--font-mono);
        font-size: var(--text-mono);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .about-footer a {
        color: var(--color-text-muted);
        text-decoration: none;
    }

    .about-footer a:hover {
        color: var(--color-accent);
    }

    @media (max-width: 768px) {
        .about {
            padding: var(--spacing-lg) 0;
        }
    }
</style>
